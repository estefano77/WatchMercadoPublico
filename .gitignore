# Compilación
# Sin el ancla inicial '^': [Bb]in/ solo ignoraba la carpeta "bin" de la RAIZ,
# y el ensamblado CLR de sql\clr\ compila a sql\clr\bin, que se colaba.
[Bb]in/
[Oo]bj/
publish/
*.user
*.suo
.vs/
node_modules/

# Configuración local: aquí va el ticket de Mercado Público. NO se versiona.
# Copia secrets\appsettings.Development.json.ejemplo y pon tu ticket ahí.
secrets/
appsettings.Development.json
appsettings.Local.json
*.env

# Publicación
#
# Con el asterisco, no solo "publicacion/". Escribido así solo ignoraba la
# carpeta con ese nombre exacto, y cualquier variante (publicacion2, una prueba
# al lado, publicacion-test) se colaba en el repositorio: llegaron a commitearse
# 74 ficheros de compilación, casi 10 MB de binarios y .pdb incluidos.
publicacion*/
publicacion