@page "/"
@implements IDisposable
@inject MercadoPublicoApi Api

<PageTitle>WatchMercadoPublico · Novedades de hoy</PageTitle>

<div class="space-y-6">

    @* ------------------------------------------------------------------ *@
    @* Encabezado: qué empresa y qué día. Ya no hay nada que elegir.        *@
    @* ------------------------------------------------------------------ *@
    <section>
        <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
            Novedades de hoy en
            <span class="marca-texto">Mercado Publico</span>
        </h1>

        @* Sin mencionar el refresco automático: es un detalle de funcionamiento
           que en la pantalla solo resta, y el usuario no puede cambiarlo. Va
           documentado en el README, que es lo que serves para el manual. *@
        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-soft">
            Licitaciones publicadas hoy para
            <strong class="text-ink">@NombreEmpresa</strong>.
        </p>
    </section>

    @* ------------------------------------------------------------------ *@
    @* Avisos                                                              *@
    @* ------------------------------------------------------------------ *@
    @* El aviso de demo va APARTE de la cadena de errores: en un 'else if' se
       comía todos los errores y en modo demo nunca se veía un fallo real. *@
    @if (Estado is { EsDemo: true })
    {
        <Aviso Tipo="aviso" Titulo="Modo demo: los datos son inventados" Cerrable="false">
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                No se está llamando a Mercado Público. Sirve para probar la pantalla sin gastar el
                cupo del ticket. Ninguna empresa, organismo, monto ni código que ves aquí existe de
                verdad.
            </p>
        </Aviso>
    }

    @if (Estado is { Servible: false })
    {
        <Aviso Tipo="error" Titulo="La aplicación no está configurada" Cerrable="false">
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                En esta pantalla <strong>@Estado.FaltaConfiguracion</strong>, así que no se puede
                consultar nada. Se pone en el servidor, en la sección
                <span class="font-mono">MercadoPublico</span> del
                <span class="font-mono">appsettings</span>:
            </p>
            <pre class="mt-3 overflow-x-auto rounded-lg border border-line bg-field px-3 py-2.5 font-mono text-[0.72rem] text-ink-soft">Copy-Item secrets\appsettings.Development.json.ejemplo `
        src\WatchMercadoPublico.Server\appsettings.Development.json</pre>
            <p class="mt-2 text-xs leading-relaxed text-muted">
                El <span class="font-mono">CodigoProveedor</span> es el único imprescindible: sin él
                no hay a quién consultar. El ticket se pide gratis en mercadopublico.cl y llega al
                correo. Para probar la pantalla sin nada de eso,
                <span class="font-mono">"ModoConsulta": "demo"</span>.
            </p>
        </Aviso>
    }

    @* ------------------------------------------------------------------ *@
    @* Estado de la consulta                                                *@
    @* ------------------------------------------------------------------ *@
    @* Dos cosas se esconden detrás de "Ocupado", y por eso NO es solo Cargando:
         1. Una consulta en vuelo.
         2. El arranque, antes de saber si la API está servible.

       La condición del bloque es "Estado is not { Servible: false }" y no
       "Servible: true" a propósito. Con la estricta, mientras /api/estado no
       responde (Estado == null) no se cumplía NINGUNA y la pantalla pintaba la
       cabecera, el título y a continuación un hueco vacío durante un minuto: sin
       panel de cargando ni de error. Y como en Blazor asignar un campo no
       repinta, el "Consultando" tampoco salía hasta terminar el await. *@
    @if (Estado is not { Servible: false })
    {
        @if (Ocupado)
        {
            <Aviso Tipo="info" Titulo="Consultando a Mercado Público…" Cerrable="false">
                <p class="mt-1.5 text-sm leading-relaxed text-ink-soft">
                    Mercado Público suele rechazar las primeras peticiones de cada sesión, así que se
                    insiste hasta un minuto antes de rendirse. No hace falta hacer nada: la pantalla se
                    actualiza sola.
                </p>
                @* Los segundos solo cuando ya tarda. En el caso rápido —que es
                   el normal— el contador sería ruido. *@
                @if (SegundosEsperando > 8)
                {
                    <p class="mt-2 flex flex-wrap items-center gap-x-2 gap-y-1 text-sm text-muted">
                        <span class="inline-flex items-center gap-1.5 font-semibold text-ink-soft">
                            <Icon Name="reloj" Size="14" />
                            @SegundosEsperando s
                        </span>
                        <span>Sigo insistiendo; el error sale al agotar los intentos.</span>
                    </p>
                }
            </Aviso>
        }
        else if (ErrorConsulta is not null)
        {
            <div class="rounded-2xl border border-rose-500/30 bg-rose-500/10 px-6 py-10 text-center">
                <span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-rose-500/15 text-rose-500">
                    <Icon Name="alerta" Size="26" />
                </span>
                <p class="mt-4 text-base font-bold text-ink">No se pudo consultar</p>
                <p class="mx-auto mt-1.5 max-w-lg text-sm leading-relaxed text-ink-soft">
                    @ErrorConsulta
                </p>
                @* No se puede decir "no hay licitaciones": lo que no se pudo fue
                   preguntar. Afirmar lo contrario sería mentir. *@
                <p class="mx-auto mt-1.5 max-w-lg text-sm text-muted">
                    Esto <strong>no</strong> significa que no haya nada publicado hoy: significa que no
                    se pudo comprobar. La pantalla lo reintenta sola cada
                    @MinutosRefresco @(MinutosRefresco == 1 ? "minuto" : "minutos").
                </p>
                <button type="button" @onclick="CargarAsync" disabled="@Cargando"
                        class="mt-5 inline-flex min-h-[46px] items-center gap-2 rounded-xl bg-gradient-to-r from-marca-a to-marca-b px-6 text-sm font-bold text-white shadow-lg shadow-violet-500/25 transition hover:brightness-110 disabled:opacity-60">
                    <Icon Name="recargar" Size="17" />
                    Intentar ahora
                </button>
            </div>
        }
        else if (Pagina is { Total: 0 })
        {
            @* Sin resultados: NO es un error. Y si hoy es fin de semana, se
               dice, porque es lo más probable y evita que parezca un fallo. *@
            <div class="rounded-2xl border border-dashed border-line bg-surface px-6 py-14 text-center">
                <span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-field text-muted">
                    <Icon Name="calendario" Size="26" />
                </span>
                <p class="mt-4 text-base font-bold text-ink">
                    @(Pagina.EsFinDeSemana
                        ? $"{Pagina.FechaLegible} es fin de semana"
                        : "Nada nuevo hoy")
                </p>
                <p class="mx-auto mt-1.5 max-w-lg text-sm leading-relaxed text-muted">
                    @(Pagina.EsFinDeSemana
                        ? "Se consultó el día y no salió ninguna licitación. Es lo normal en fin de semana: lo habitual es que se publiquen de lunes a viernes. La página lo reintenta sola y aparecerá solo si se publica algo."
                        : "Se consultó el día completo y esta empresa no tiene ninguna licitación publicada. Es una respuesta real, no un fallo: significa que hoy no hay novedad.")
                </p>
            </div>
        }
        else if (Pagina is not null)
        {
            @* --- Cabecera de resultados --- *@
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                    <h2 class="text-base font-bold text-ink">
                        @(Pagina.Total == 1 ? "1 novedad" : $"{Pagina.Total} novedades")
                    </h2>
                    <span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-[0.68rem] font-bold text-emerald-600 uppercase dark:text-emerald-400">
                        Hoy
                    </span>
                </div>
                <p class="text-xs text-muted">
                    @(Pagina.DesdeCache
                        ? $"consultado a las {Formato.Hora(Pagina.Consultado)}"
                        : $"consultado a la API a las {Formato.Hora(Pagina.Consultado)}")
                </p>
            </div>

            <div class="space-y-3">
                @foreach (var licitacion in Pagina.Items)
                {
                    <FichaLicitacion Licitacion="licitacion" Palabras="@([])"
                                     AbrirAsync="AbrirDetalleAsync" />
                }
            </div>
        }
    }
</div>

@* --- Modal de detalle --- *@
@* Todos los valores van con '@': un parámetro de tipo string recibe LITERAL lo
   que se escriba, y sin '@' el modal pintaba el texto "errorDetalle" como si
   fuera el mensaje de error. *@
<ModalDetalle Licitacion="@abierta"
             Detalle="@detalleAbierto"
             Cargando="@cargandoDetalle"
             DesdeCache="@detalleDesdeCache"
             MensajeError="@errorDetalle"
             OnCerrar="CerrarDetalleAsync" />

@code {
    private EstadoApi? Estado { get; set; }
    private PaginaLicitaciones? Pagina { get; set; }

    /// <summary>
    /// Hay una consulta en vuelo.
    ///
    /// No nace en true: arrancarla en true haría que la primera llamada a
    /// <c>CargarAsync</c> saliera por su guarda <c>if (Cargando) return;</c> y la
    /// consulta inicial no llegaría a lanzarse. El arranque lo cubre
    /// <see cref="Ocupado"/>.
    /// </summary>
    private bool Cargando { get; set; }

    private string? ErrorConsulta { get; set; }

    /// <summary>
    /// occupied la pantalla sin poder mostrar un resultado todavía: o hay una
    /// consulta en vuelo, o aún no se sabe si la API está servible.
    ///
    /// Sin el segundo caso, el primer render (con <see cref="Estado"/> a null y
    /// <see cref="Cargando"/> a false) no cumplía ninguna condición y pintaba un
    /// hueco vacío durante el tiempo que tarda el servidor en insistir.
    /// </summary>
    private bool Ocupado => Cargando || (Estado is null && ErrorConsulta is null);

    /// <summary>Segundos que lleva esperando la respuesta, para el contador.</summary>
    private int SegundosEsperando { get; set; }

    /// <summary>
    /// Refresco automático mientras la pantalla está abierta.
    ///
    /// Es un System.Timers.Timer y no un bucle con await Task.Delay porque al
    /// cortar Blazor hay que PARARLO. Un bucle seguiría consultando en el
    /// servidor del navegador, gastando el cupo del ticket sin que nadie mire la
    /// pantalla. Un temporizador sin desuscribir es exactamente ese bug.
    /// </summary>
    private System.Timers.Timer? temporizador;

    /// <summary>
    /// Cuenta los segundos de espera, a 1 por segundo.
    ///
    /// Hace falta porque Blazor solo repinta cuando termina un <c>await</c>: con
    /// el servidor insistir un minuto, el "Consultando" se quedaba congelado
    /// durante los 90 s y parecía una página colgada. El contador deja claro que
    /// algo se está moviendo.
    /// </summary>
    private System.Timers.Timer? reloj;

    // Detalle abierto
    private Licitacion? abierta { get; set; }
    private DetalleLicitacion? detalleAbierto { get; set; }
    private bool cargandoDetalle { get; set; }
    private bool detalleDesdeCache { get; set; }
    private string? errorDetalle { get; set; }

    private string NombreEmpresa => Estado?.Empresa?.Nombre ?? "…";
    private int MinutosRefresco => Estado?.MinutosEntreRefrescos is > 0 ? Estado.MinutosEntreRefrescos : 5;

    protected override async Task OnInitializedAsync()
    {
        var (estado, error) = await Api.GetEstadoAsync();
        Estado = estado;

        if (estado is null)
        {
            ErrorConsulta = error ?? "No se pudo conectar con el servidor.";

            // Sin este repintado, el error no se vería nunca: el primer
            // render ya salió con el panel de cargando, y como asignar
            // campos no repinta, el aviso solo aparecería al terminar el
            // siguiente await.
            Cargando = false;
            StateHasChanged();
            return;
        }

        // Igual aquí: con el nombre de la empresa ya se puede pintar el
        // encabezado, y el "Consultando" pasa a tener el contexto de a qué
        // empresa se está mirando.
        StateHasChanged();

        await CargarAsync();
        ProgramarRefresco();
    }

    /// <summary>
    /// Consulta las novedades de hoy.
    ///
    /// No lleva CancellationToken a propósito: si la cancelamos a mitad, el
    /// servidor sigue insistiendo con sus reintentos y el trabajo se tira
    /// (junto con el cupo). El botón queda bloqueado mientras tanto, así que no
    /// se solapan peticiones.
    /// </summary>
    private async Task CargarAsync()
    {
        // El guard salta en la recarga del temporizador mientras aún no ha
        // terminado la anterior: el servidor no necesita dos consultas a la vez
        // del mismo día, que además gastarían el cupo.
        if (Cargando) return;

        Cargando = true;
        ErrorConsulta = null;
        IniciarReloj();

        try
        {
            var (resultado, error) = await Api.GetHoyAsync();

            if (error is not null)
            {
                ErrorConsulta = error;
                return;
            }

            Pagina = resultado;
        }
        finally
        {
            Cargando = false;
            PararReloj();
        }
    }

    /// <summary>Arranca el contador de segundos de espera.</summary>
    private void IniciarReloj()
    {
        SegundosEsperando = 0;

        reloj?.Dispose();
        reloj = new System.Timers.Timer(1000) { AutoReset = true };

        reloj.Elapsed += (_, _) => InvokeAsync(() =>
        {
            SegundosEsperando++;

            // Repintar a mano: al no haber ningún await en curso, Blazor solo
            // repintaría cuando terminara la consulta, y el contador se
            // quedaría en 0 durante los 90 s.
            StateHasChanged();
        });

        reloj.Start();
    }

    /// <summary>Para el contador de segundos.</summary>
    private void PararReloj()
    {
        reloj?.Stop();
        reloj?.Dispose();
        reloj = null;
    }

    /// <summary>
    /// Refresco periódico. Se para en Dispose.
    ///
    /// Con 5 minutos son 12 peticiones por hora: una fracción del cupo diario de
    /// 10.000, y como el servidor insiste hasta un minuto cuando falla, la caché
    /// de 4 minutos hace que la mayoría de estos refrescos pregunten de verdad.
    /// </summary>
    private void ProgramarRefresco()
    {
        if (MinutosRefresco <= 0) return;

        temporizador = new System.Timers.Timer
        {
            Interval = TimeSpan.FromMinutes(MinutosRefresco).TotalMilliseconds,
            AutoReset = false,
        };

        // AutoReset = false y se rearma al final: si el servidor tardó un minuto
        // con sus reintentos, el siguiente disparo se cuenta desde que terminó y
        // no se solapan. Con AutoReset = true se acumularían peticiones.
        temporizador.Elapsed += async (_, _) =>
        {
            await InvokeAsync(async () =>
            {
                await CargarAsync();
                ProgramarRefresco();
            });
        };

        temporizador.Start();
    }

    // ------------------------------------------------------------------
    // Detalle
    // ------------------------------------------------------------------

    /// <summary>
    /// Abre la ficha y pide su detalle. Es una petición por licitación, así que
    /// solo se hace al abrir: pedirlas todas al cargar gastaría cupo sin
    /// necesidad.
    /// </summary>
    private async Task AbrirDetalleAsync(Licitacion licitacion)
    {
        abierta = licitacion;
        detalleAbierto = null;
        errorDetalle = null;
        cargandoDetalle = true;
        detalleDesdeCache = false;

        if (string.IsNullOrWhiteSpace(licitacion.CodigoExterno))
        {
            errorDetalle = "Esta licitación no trae código, así que no se puede consultar su detalle.";
            cargandoDetalle = false;
            return;
        }

        var (detalle, desdeCache, error) = await Api.GetDetalleAsync(licitacion.CodigoExterno);

        // Si el modal se cerró mientras esperaba, el resultado se descarta.
        if (abierta?.CodigoExterno != licitacion.CodigoExterno) return;

        detalleAbierto = detalle;
        detalleDesdeCache = desdeCache;
        errorDetalle = error;
        cargandoDetalle = false;
    }

    private Task CerrarDetalleAsync()
    {
        CerrarDetalle();
        return Task.CompletedTask;
    }

    private void CerrarDetalle()
    {
        abierta = null;
        detalleAbierto = null;
        cargandoDetalle = false;
        detalleDesdeCache = false;
        errorDetalle = null;
    }

    public void Dispose()
    {
        // Sin esto el temporizador seguiría consultando en segundo plano con la
        // pantalla cerrada.
        temporizador?.Stop();
        temporizador?.Dispose();

        // El reloj también: si no, seguiría pidiendo repintados sobre un
        // componente ya descartado, que en Blazor lanza.
        PararReloj();
    }
}
