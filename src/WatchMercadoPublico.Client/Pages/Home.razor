@page "/"
@implements IDisposable
@inject MercadoPublicoApi Api

<PageTitle>WatchMercadoPublico · Licitaciones de la semana</PageTitle>

<div class="space-y-6">

    @* ------------------------------------------------------------------ *@
    @* Encabezado                                                           *@
    @* ------------------------------------------------------------------ *@
    <section>
        <h1 class="text-2xl font-extrabold tracking-tight sm:text-3xl">
            Novedades en
            <span class="marca-texto">Mercado Publico</span>
        </h1>

        <p class="mt-2 max-w-2xl text-sm leading-relaxed text-ink-soft">
            Licitaciones de <strong class="text-ink">@RangoEnPalabras</strong> para
            <strong class="text-ink">@NombreEmpresa</strong>.
        </p>
    </section>

    @* ------------------------------------------------------------------ *@
    @* Filtros: año, mes y semana. Los tres CONCATENADOS: la unidad que se      *@
    @* consulta es UNA semana, no un mes ni un año.                            *@
    @* ------------------------------------------------------------------ *@
    @if (Estado is not { Servible: false })
    {
        <section class="rounded-2xl border border-line bg-surface p-4">
            <div class="flex flex-wrap items-end gap-3">

                <div class="min-w-[7rem] flex-1">
                    <label for="f-anio" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-muted">
                        Año
                    </label>
                    <select id="f-anio" class="campo" value="@Anio" @onchange="CambiarAnio">
                        @foreach (var a in Estado?.AniosDisponibles ?? [])
                        {
                            <option value="@a" selected="@(a == Anio)">@a</option>
                        }
                    </select>
                </div>

                <div class="min-w-[9rem] flex-1">
                    <label for="f-mes" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-muted">
                        Mes
                    </label>
                    <select id="f-mes" class="campo" value="@Mes" @onchange="CambiarMes">
                        @for (var m = 1; m <= 12; m++)
                        {
                            var numero = m;
                            var nombre = NombreDeMes(numero);
                            <option value="@numero" selected="@(numero == Mes)">@nombre</option>
                        }
                    </select>
                </div>

                <div class="min-w-[9rem] flex-1">
                    <label for="f-semana" class="mb-1.5 block text-xs font-semibold uppercase tracking-wide text-muted">
                        Semana
                    </label>
                    <select id="f-semana" class="campo" value="@NumeroSemana" @onchange="CambiarSemana">
                        @foreach (var s in SemanasDisponibles)
                        {
                            <option value="@s" selected="@(s == NumeroSemana)">Semana @s - @RangoDeSemana(s)</option>
                        }
                    </select>
                </div>

                <button type="button" class="boton-actualizar" @onclick="ActualizarAsync" disabled="@Cargando">
                    @if (Cargando)
                    {
                        <span class="icono-girando"><Icon Name="recargar" Size="17" /></span>
                        <span>Consultando…</span>
                    }
                    else
                    {
                        <Icon Name="recargar" Size="17" />
                        <span>Actualizar</span>
                    }
                </button>
            </div>

            @* Detalle de lo que se está mirando. Con los fines de semana incluidos
               en el rango pero no consultados, que es una diferencia que sin decir
               parece un error de cálculo. *@
            <p class="mt-3 text-xs leading-relaxed text-muted">
                Del @DiaCorto(Desde) al @DiaCorto(Hasta) · @TextoDiasHabiles
                @if (!EsSemanaActual)
                {
                    <span>· Esta semana ya pasó, así que no se vuelve a preguntar lo mismo.</span>
                }
            </p>
        </section>
    }

    @* ------------------------------------------------------------------ *@
    @* Avisos                                                              *@
    @* ------------------------------------------------------------------ *@
    @* El aviso de demo va APARTE de la cadena de errores: en un 'else if' se
       comía todos los errores y en modo demo nunca se veía un fallo real. *@
    @if (Estado is { EsDemo: true })
    {
        <Aviso Tipo="aviso" Titulo="Modo demo: los datos son inventados" Cerrable="false">
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                No se está llamando a Mercado Público. Sirve para probar la pantalla sin gastar el
                cupo del ticket. Ninguna empresa, organismo, monto ni código que ves aquí existe de
                verdad.
            </p>
        </Aviso>
    }

    @if (Estado is { Servible: false })
    {
        <Aviso Tipo="error" Titulo="La aplicación no está configurada" Cerrable="false">
            <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                En esta pantalla <strong>@Estado.FaltaConfiguracion</strong>, así que no se puede
                consultar nada. Se pone en el servidor, en la sección
                <span class="font-mono">MercadoPublico</span> del
                <span class="font-mono">appsettings</span>:
            </p>
            <pre class="mt-3 overflow-x-auto rounded-lg border border-line bg-field px-3 py-2.5 font-mono text-[0.72rem] text-ink-soft">Copy-Item secrets\appsettings.Development.json.ejemplo `
        src\WatchMercadoPublico.Server\appsettings.Development.json</pre>
            <p class="mt-2 text-xs leading-relaxed text-muted">
                El <span class="font-mono">CodigoProveedor</span> es el único imprescindible: sin él
                no hay a quién consultar. El ticket se pide gratis en mercadopublico.cl y llega al
                correo. Para probar la pantalla sin nada de eso,
                <span class="font-mono">"ModoConsulta": "demo"</span>.
            </p>
        </Aviso>
    }

    @* ------------------------------------------------------------------ *@
    @* Estado de la consulta                                                *@
    @* ------------------------------------------------------------------ *@
    @* Dos cosas se esconden detrás de "Ocupado", y por eso NO es solo Cargando:
         1. Una consulta en vuelo.
         2. El arranque, antes de saber si la API está servible. *@
    @if (Estado is not { Servible: false })
    {
        @* Aviso de días que aún no han llegado. Va FUERA de la cadena de
           estados a propósito: si estuviera dentro de "hay resultados", una
           semana vacía y a medio terminar no lo enseñaría, y es justo el caso
           en que hace falta. No es un fallo: es que el día no ha llegado. *@
        @if (Semana is { AFuturo: true })
        {
            <p class="entrada-suave rounded-2xl border border-line bg-field px-4 py-3 text-sm leading-relaxed text-ink-soft">
                @Semana.DiasPendientes
                @(Semana.DiasPendientes == 1
                    ? "día hábil de esta semana todavía no ha llegado"
                    : "días hábiles de esta semana todavía no han llegado"),
                así que no se han consultado. Es normal: la semana aún no
                termina. Esta pantalla se actualiza sola.
            </p>
        }

        @if (Ocupado)
        {
            @* Esqueleto en vez de un simple "cargando": el usuario ve que hay
               una pantalla formándose, no una página muerta. *@
            <div class="space-y-4">
                <div class="tarjeta-esqueleto">
                    <div class="esqueleto h-5 w-52"></div>
                    <div class="esqueleto mt-3 h-3.5 w-full"></div>
                    <div class="esqueleto mt-2 h-3.5 w-4/5"></div>
                </div>
                <div class="tarjeta-esqueleto">
                    <div class="esqueleto h-5 w-44"></div>
                    <div class="esqueleto mt-3 h-3.5 w-full"></div>
                    <div class="esqueleto mt-2 h-3.5 w-3/5"></div>
                </div>

                <div class="flex items-center justify-center gap-2.5 pt-1 text-sm text-ink-soft">
                    <span class="punto-pulsante"></span>
                    <span>Consultando a Mercado Público…</span>
                    @if (SegundosEsperando > 4)
                    {
                        <span class="tabular-nums text-muted">@SegundosEsperando s</span>
                    }
                </div>
            </div>
        }
        else if (ErrorConsulta is not null)
        {
            <div class="entrada-suave rounded-2xl border border-rose-500/30 bg-rose-500/10 px-6 py-10 text-center">
                <span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-rose-500/15 text-rose-500">
                    <Icon Name="alerta" Size="26" />
                </span>
                <p class="mt-4 text-base font-bold text-ink">No se pudo consultar</p>
                <p class="mx-auto mt-1.5 max-w-lg text-sm leading-relaxed text-ink-soft">
                    @ErrorConsulta
                </p>
                @* No se puede decir "no hay licitaciones": lo que no se pudo fue
                   preguntar. Afirmar lo contrario sería mentir. *@
                <p class="mx-auto mt-1.5 max-w-lg text-sm text-muted">
                    Esto <strong>no</strong> significa que no haya nada publicado esa semana: significa
                    que no se pudo comprobar.
                </p>
                <button type="button" @onclick="ActualizarAsync" disabled="@Cargando"
                        class="boton-actualizar mt-5">
                    <Icon Name="recargar" Size="17" />
                    Intentar ahora
                </button>
            </div>
        }
        else if (Semana is { Total: 0 })
        {
            @* Sin resultados: NO es un error, siempre que la semana se haya
               comprobado entera. *@
            <div class="entrada-suave rounded-2xl border border-dashed border-line bg-surface px-6 py-14 text-center">
                <span class="mx-auto grid h-14 w-14 place-items-center rounded-2xl bg-field text-muted">
                    <Icon Name="calendario" Size="26" />
                </span>
                <p class="mt-4 text-base font-bold text-ink">Nada en esa semana</p>
                <p class="mx-auto mt-1.5 max-w-lg text-sm leading-relaxed text-muted">
                    Se consultaron @TextoDiasConsultados y no salió ninguna licitación de esta
                    empresa. Es una respuesta real, no un fallo.
                </p>
            </div>
        }
        else if (Semana is not null)
        {

            @* --- Cabecera de resultados --- *@
            <div class="flex flex-wrap items-center justify-between gap-2">
                <div class="flex items-center gap-2">
                    <h2 class="text-base font-bold text-ink">
                        @(Semana.Total == 1 ? "1 novedad" : $"{Semana.Total} novedades")
                    </h2>
                    <span class="rounded-full bg-emerald-500/15 px-2.5 py-0.5 text-[0.68rem] font-bold text-emerald-600 uppercase dark:text-emerald-400">
                        @RangoCorto
                    </span>
                </div>
                <p class="text-xs text-muted">
                    @(Semana.DesdeCache
                        ? $"consultado a las {Formato.Hora(Semana.Consultado)}"
                        : $"consultado a la API a las {Formato.Hora(Semana.Consultado)}")
                </p>
            </div>

            @* --- Aviso de días sin comprobar --- *@
            @* Es lo que impide que la pantalla insinúe un "no hay nada" cuando en
               realidad hay días que nadie ha podido mirar. *@
            @if (!Semana.Completa)
            {
                <Aviso Tipo="aviso" Titulo="La semana está incompleta" Cerrable="false">
                    <p class="mt-2 text-sm leading-relaxed text-ink-soft">
                        Se consultaron @Semana.DiasConsultados días hábiles pero
                        <strong>@Semana.DiasFallidos no respondieron</strong>
                        (@DiasFallidosEnPalabras). Lo que ves está completo, pero
                        puede que falte algo de esos días. Vuelve a actualizar en unos
                        segundos.
                    </p>
                </Aviso>
            }

            @* --- Resultados, agrupados por día --- *@
            @* Agrupar evita repetir el día en cada ficha, que con una semana de
               cinco días es una de cada dos líneas. *@
            <div class="space-y-5">
                @foreach (var grupo in Semana.PorDia)
                {
                    <section class="entrada-suave">
                        <h3 class="mb-2 flex items-center gap-2 text-xs font-bold uppercase tracking-wide text-muted">
                            <Icon Name="calendario" Size="13" />
                            @DiaEnPalabras(grupo.Key)
                            <span class="font-normal normal-case tracking-normal text-muted opacity-70">
                                (@grupo.Count() @(grupo.Count() == 1 ? "novedad" : "novedades"))
                            </span>
                        </h3>

                        <div class="space-y-3">
                            @foreach (var licitacion in grupo)
                            {
                                <FichaLicitacion Licitacion="@licitacion" Palabras="@([])"
                                                 AbrirAsync="AbrirDetalleAsync" />
                            }
                        </div>
                    </section>
                }
            </div>
        }
    }
        else
        {
            @* Esta rama no debería verse NUNCA: todo lo demás está cubierto
               arriba. Se deja igualmente porque el fallo de no tenerla es
               silencioso y feo: la pantalla se queda con la cabecera y los
               filtros, y debajo un hueco sin explicación. Con esta rama, si
               algún día se cuela un estado sin pintar, se ve un texto en vez
               de nada. *@
            <div class="entrada-suave rounded-2xl border border-dashed border-line bg-surface px-6 py-10 text-center">
                <p class="text-base font-bold text-ink">No hay nada que mostrar</p>
                <p class="mx-auto mt-1.5 max-w-lg text-sm leading-relaxed text-muted">
                    No se pudo pintar el contenido de la consulta. Vuelve a
                    actualizar en unos segundos.
                </p>
                <button type="button" @onclick="ActualizarAsync" disabled="@Cargando"
                        class="boton-actualizar mt-5">
                    <Icon Name="recargar" Size="17" />
                    <span>Actualizar</span>
                </button>
            </div>
        }
</div>

@* --- Modal de detalle --- *@
@* Todos los valores van con '@': un parámetro de tipo string recibe LITERAL lo
   que se escriba, y sin '@' el modal pintaba el texto "errorDetalle" como si
   fuera el mensaje de error. *@
<ModalDetalle Licitacion="@abierta"
             Detalle="@detalleAbierto"
             Cargando="@cargandoDetalle"
             DesdeCache="@detalleDesdeCache"
             MensajeError="@errorDetalle"
             OnCerrar="CerrarDetalleAsync" />

@code {
    private EstadoApi? Estado { get; set; }
    private SemanaLicitaciones? Semana { get; set; }

    private bool Cargando { get; set; }
    private string? ErrorConsulta { get; set; }

    /// <summary>Segundos que lleva esperando la respuesta, para el contador.</summary>
    private int SegundosEsperando { get; set; }

    // Selección
    // Selección. NO se dejan en 0 a propósito: el primer render ocurre antes de
    // que GetEstadoAsync responda, y con Mes = 0 la cabecera pedía el nombre del
    // mes 0 y Blazor tiraba ArgumentOutOfRangeException. Es el mismo fallo de
    // antes en otra forma: el estado de arranque necesita una representación,
    // aunque no sea la buena.
    private int Anio { get; set; } = DateTime.Today.Year;
    private int Mes { get; set; } = DateTime.Today.Month;
    private int NumeroSemana { get; set; } = 1;

    private System.Timers.Timer? temporizador;
    private System.Timers.Timer? reloj;

    // Detalle abierto
    private Licitacion? abierta { get; set; }
    private DetalleLicitacion? detalleAbierto { get; set; }
    private bool cargandoDetalle { get; set; }
    private bool detalleDesdeCache { get; set; }
    private string? errorDetalle { get; set; }

    private static readonly string[] DiasSemana =
        ["lunes", "martes", "miércoles", "jueves", "viernes", "sábado", "domingo"];

    private string NombreEmpresa => Estado?.Empresa?.Nombre ?? "…";
    private int MinutosRefresco => Estado?.MinutosEntreRefrescos is > 0 ? Estado.MinutosEntreRefrescos : 5;

    /// <summary>
    /// occupied la pantalla sin poder mostrar un resultado todavía: o hay una
    /// consulta en vuelo, o aún no se sabe si la API está servible.
    /// </summary>
    private bool Ocupado => Cargando || (Estado is null && ErrorConsulta is null);

    /// <summary>
    /// Nombre del mes, para el desplegable y los rótulos.
    ///
    /// Acota a 1..12 porque <c>DateTimeFormat.GetMonthName(0)</c> lanza
    /// ArgumentOutOfRangeException, y que un rótulo tumbe la pantalla es peor que
    /// un rótulo feo.
    /// </summary>
    private string NombreDeMes(int m)
    {
        m = Math.Clamp(m, 1, 12);

        return Estado?.MesesDisponibles is { Count: >= 12 } nombres
            ? nombres[m - 1]
            : CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m);
    }

    /// <summary>
    /// Cuántas semanas tiene el mes elegido. Se calcula igual que en el servidor:
    /// la última puede ser más corta y una puede caer entera en fin de semana.
    ///
    /// Con un año o un mes imposibles devuelve una sola semana en vez de lanzar:
    /// <c>DateTime.DaysInMonth(0, 0)</c> revienta, y este valor se calcula en
    /// cada render, también el primero.
    /// </summary>
    private List<int> SemanasDisponibles
    {
        get
        {
            var dias = Anio is < 1 or > 9999 || Mes is < 1 or > 12
                ? 31
                : DateTime.DaysInMonth(Anio, Mes);

            var total = (dias + 6) / 7;
            return Enumerable.Range(1, total).ToList();
        }
    }

    /// <summary>
    /// ¿Lo que se está mirando es la semana en que estamos? Decide si tiene
    /// sentido el refresco automático: una semana pasada no va a cambiar.
    /// </summary>
    private bool EsSemanaActual
    {
        get
        {
            var hoy = DateOnly.FromDateTime(DateTime.Today);
            return Anio == hoy.Year && Mes == hoy.Month && NumeroSemana == SemanaDe(hoy);
        }
    }

    /// <summary>
    /// Rango de la semana tal como se muestra en el desplegable: "5 al 11 de
    /// Octubre". Incluye sábado y domingo, porque una semana va de lunes a
    /// domingo; solo el PROCESO se queda con los días hábiles.
    ///
    /// Es el mismo cálculo que hace SemanasDelMes en el servidor, y a propósito
    /// está duplicado: el cliente no puede llamar al servidor para rotular cuatro
    /// opciones, y el servidor es quien manda. Lo que ata las dos copias es
    /// SemanasDelMesTests, que fija el caso de octubre de 2026 con todos sus
    /// rangos. Si se cambia la regla hay que cambiar las dos cosas.
    /// </summary>
    private string RangoDeSemana(int semana)
    {
        var primeroDelMes = new DateOnly(Anio, Mes, 1);
        var ultimoDelMes = new DateOnly(Anio, Mes, DateTime.DaysInMonth(Anio, Mes));

        // .NET: DayOfWeek empieza en DOMINGO = 0.
        var hastaElDomingo = (7 - (int)primeroDelMes.DayOfWeek) % 7;
        var longitudPrimera = hastaElDomingo + 1;

        var desplazamiento = 0;
        for (var k = 1; k < semana; k++) desplazamiento += k == 1 ? longitudPrimera : 7;

        var desde = primeroDelMes.AddDays(desplazamiento);
        if (desde > ultimoDelMes) desde = ultimoDelMes;

        var hasta = semana == 1 ? desde.AddDays(longitudPrimera - 1) : desde.AddDays(6);
        if (hasta > ultimoDelMes) hasta = ultimoDelMes;

        // "5 al 11" cuando los meses no cambian; si la semana toca dos meses, se
        // dice, porque "del 26 al 31" no basta para saber a qué mes pertenece.
        var nombre = NombreDeMes(desde.Month).ToLowerInvariant();

        return hasta.Month != desde.Month
            ? $"{desde.Day} de {NombreDeMes(desde.Month).ToLowerInvariant()} al {hasta.Day} de {NombreDeMes(hasta.Month).ToLowerInvariant()}"
            : $"{desde.Day} al {hasta.Day} de {nombre}";
    }

    private static int SemanaDe(DateOnly d)
        => SemanasDelMesDelCliente.SemanaDe(d.Year, d.Month, d);

    /// <summary>
    /// Copia de SemanasDelMes del servidor, para no tener la regla en dos
    /// sitios distintos. Lo ata SemanasDelMesTests, en el servidor.
    /// </summary>
    private static class SemanasDelMesDelCliente
    {
        public static int SemanaDe(int anio, int mes, DateOnly fecha)
        {
            if (anio is < 1 or > 9999 || mes is < 1 or > 12) return 1;
            if (fecha.Year != anio || fecha.Month != mes) return 1;

            var hastaElDomingo = (7 - (int)new DateOnly(anio, mes, 1).DayOfWeek) % 7;
            var longitudPrimera = hastaElDomingo + 1;
            var ultimoDelMes = new DateOnly(anio, mes, DateTime.DaysInMonth(anio, mes));
            var total = Math.Max(1, 1 + Math.Max(0, (ultimoDelMes.Day - longitudPrimera + 6) / 7));

            for (var s = 1; s <= total; s++)
            {
                var desplazamiento = 0;
                for (var k = 1; k < s; k++) desplazamiento += k == 1 ? longitudPrimera : 7;

                var desde = new DateOnly(anio, mes, 1).AddDays(desplazamiento);
                var hasta = s == 1 ? desde.AddDays(longitudPrimera - 1) : desde.AddDays(6);
                if (hasta > ultimoDelMes) hasta = ultimoDelMes;

                if (fecha >= desde && fecha <= hasta) return s;
            }

            return 1;
        }
    }

    // --- Rótulos del rango ---

    private DateOnly? Desde => Semana?.Desde is { } d ? DateOnly.Parse(d) : null;
    private DateOnly? Hasta => Semana?.Hasta is { } h ? DateOnly.Parse(h) : null;

    private string RangoEnPalabras =>
        $"la semana {NumeroSemana} de {NombreDeMes(Mes).ToLowerInvariant()} de {Anio}";

    private string RangoCorto => $"Semana {NumeroSemana}";

    private string TextoDiasHabiles =>
        Semana is null
            ? "los días hábiles de la semana"
            : Semana.DiasHabiles == 1 ? "1 día hábil" : $"{Semana.DiasHabiles} días hábiles";

    /// <summary>
    /// Cuántos días se CONSULTARON de verdad. Distinto del total de la semana:
    /// si la semana aún no termina, no se han preguntado los días futuros, y
    /// decir "se consultaron 5" cuando se preguntaron 2 es mentir.
    /// </summary>
    private string TextoDiasConsultados =>
        Semana is null
            ? "los días hábiles de la semana"
            : Semana.DiasConsultados == 1 ? "1 día hábil" : $"{Semana.DiasConsultados} días hábiles";

    private string DiaCorto(DateOnly? d) =>
        d is null ? "—" : $"{d.Value.Day} de {NombreDeMes(d.Value.Month).ToLowerInvariant()}";

    private string DiaEnPalabras(DateOnly d) =>
        $"{DiasSemana[(int)d.DayOfWeek]} {d.Day} de {NombreDeMes(d.Month).ToLowerInvariant()}";

    private string DiasFallidosEnPalabras
    {
        get
        {
            var n = Semana?.DiasFallidos ?? 0;
            return n == 1 ? "1 día" : $"{n} días";
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var (estado, error) = await Api.GetEstadoAsync();
        Estado = estado;

        if (estado is null)
        {
            ErrorConsulta = error ?? "No se pudo conectar con el servidor.";
            Cargando = false;
            StateHasChanged();
            return;
        }

        // Arranca en la semana en curso, que es lo que se mira casi siempre.
        Anio = estado.Anio;
        Mes = estado.Mes;
        NumeroSemana = estado.Semana;

        StateHasChanged();

        await CargarAsync();
        ProgramarRefresco();
    }

    // ------------------------------------------------------------------
    // Filtros
    // ------------------------------------------------------------------

    private void CambiarAnio(ChangeEventArgs e)
    {
        // Se valida antes de guardar: un año imposible dejaría la pantalla
        // en un estado que no se puede ni pintar.
        if (int.TryParse(e.Value?.ToString(), out var n) && n is >= 1 and <= 9999 && n != Anio)
        {
            Anio = n;
            AjustarSemanaAlMes();
        }
    }

    private void CambiarMes(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n) && n is >= 1 and <= 12 && n != Mes)
        {
            Mes = n;
            AjustarSemanaAlMes();
        }
    }

    private void CambiarSemana(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var n) && n >= 1 && n != NumeroSemana)
        {
            NumeroSemana = n;
        }
    }

    /// <summary>
    /// Al cambiar de mes, la semana elegida puede no existir: octubre tiene 5 y
    /// septiembre 5, pero no todos los meses. Se deja la última, que siempre
    /// existe, en vez de dejar el número colgando sin opción a la que
    /// pertenecer.
    /// </summary>
    private void AjustarSemanaAlMes()
    {
        var maximo = SemanasDisponibles.Count;
        if (NumeroSemana > maximo) NumeroSemana = maximo;
        if (NumeroSemana < 1) NumeroSemana = 1;
    }

    /// <summary>Botón "Actualizar".</summary>
    private Task ActualizarAsync() => CargarAsync(refrescar: true);

    // ------------------------------------------------------------------
    // Consulta
    // ------------------------------------------------------------------

    /// <summary>
    /// Consulta la semana seleccionada.
    ///
    /// No lleva CancellationToken a propósito: si se cancela a mitad, el
    /// servidor sigue insistiendo con sus reintentos y el trabajo se tira
    /// (junto con el cupo). El botón queda bloqueado mientras tanto, así que
    /// no se solapan peticiones.
    /// </summary>
    private async Task CargarAsync(bool refrescar = false)
    {
        // El guard salta en la recarga del temporizador mientras aún no ha
        // terminado la anterior.
        if (Cargando) return;

        Cargando = true;
        ErrorConsulta = null;
        IniciarReloj();

        try
        {
            var (resultado, error) = await Api.GetSemanaAsync(Anio, Mes, NumeroSemana, refrescar);

            if (error is not null)
            {
                ErrorConsulta = error;
                return;
            }

            Semana = resultado;
        }
        finally
        {
            Cargando = false;
            PararReloj();
        }
    }

    /// <summary>Arranca el contador de segundos de espera.</summary>
    private void IniciarReloj()
    {
        SegundosEsperando = 0;

        reloj?.Dispose();
        reloj = new System.Timers.Timer(1000) { AutoReset = true };

        reloj.Elapsed += (_, _) => InvokeAsync(() =>
        {
            SegundosEsperando++;

            // Repintar a mano: al no haber ningún await en curso, Blazor solo
            // repintaría cuando terminara la consulta, y el contador se
            // quedaría en 0 durante los 30 s.
            StateHasChanged();
        });

        reloj.Start();
    }

    /// <summary>Para el contador de segundos.</summary>
    private void PararReloj()
    {
        reloj?.Stop();
        reloj?.Dispose();
        reloj = null;
    }

    /// <summary>
    /// Refresco automático, SOLO si se está mirando la semana en curso.
    ///
    /// Una semana pasada no va a cambiar: repreguntarla gastaría cuota para
    /// devolver exactamente lo mismo. Por eso el temporizador se rearma al
    /// cambiar de semana y no se programa en absoluto para las antiguas.
    /// </summary>
    private void ProgramarRefresco()
    {
        temporizador?.Stop();
        temporizador?.Dispose();
        temporizador = null;

        if (MinutosRefresco <= 0 || !EsSemanaActual) return;

        temporizador = new System.Timers.Timer
        {
            Interval = TimeSpan.FromMinutes(MinutosRefresco).TotalMilliseconds,
            AutoReset = false,
        };

        // AutoReset = false y se rearma al final: si el servidor tardó un
        // minuto con sus reintentos, el siguiente disparo se cuenta desde que
        // terminó y no se solapan.
        temporizador.Elapsed += async (_, _) =>
        {
            await InvokeAsync(async () =>
            {
                await CargarAsync();
                ProgramarRefresco();
            });
        };

        temporizador.Start();
    }

    // ------------------------------------------------------------------
    // Detalle
    // ------------------------------------------------------------------

    /// <summary>
    /// Abre la ficha y pide su detalle. Es una petición por licitación, así que
    /// solo se hace al abrir: pedirlas todas al cargar gastaría cupo sin
    /// necesidad.
    /// </summary>
    private async Task AbrirDetalleAsync(Licitacion licitacion)
    {
        abierta = licitacion;
        detalleAbierto = null;
        errorDetalle = null;
        cargandoDetalle = true;
        detalleDesdeCache = false;

        if (string.IsNullOrWhiteSpace(licitacion.CodigoExterno))
        {
            errorDetalle = "Esta licitación no trae código, así que no se puede consultar su detalle.";
            cargandoDetalle = false;
            return;
        }

        var (detalle, desdeCache, error) = await Api.GetDetalleAsync(licitacion.CodigoExterno);

        // Si el modal se cerró mientras esperaba, el resultado se descarta.
        if (abierta?.CodigoExterno != licitacion.CodigoExterno) return;

        detalleAbierto = detalle;
        detalleDesdeCache = desdeCache;
        errorDetalle = error;
        cargandoDetalle = false;
    }

    private Task CerrarDetalleAsync()
    {
        CerrarDetalle();
        return Task.CompletedTask;
    }

    private void CerrarDetalle()
    {
        abierta = null;
        detalleAbierto = null;
        cargandoDetalle = false;
        detalleDesdeCache = false;
        errorDetalle = null;
    }

    public void Dispose()
    {
        // Sin esto el temporizador seguiría consultando en segundo plano con la
        // pantalla cerrada.
        temporizador?.Stop();
        temporizador?.Dispose();

        // El reloj también: si no, seguiría pidiendo repintados sobre un
        // componente ya descartado, que en Blazor lanza.
        PararReloj();
    }
}
