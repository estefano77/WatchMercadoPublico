@inherits LayoutComponentBase
@inject ThemeService Tema

<div class="relative min-h-dvh bg-canvas text-ink antialiased">
    @* Auroras de fondo, con los colores de la marca *@
    <div class="pointer-events-none fixed inset-0 overflow-hidden" aria-hidden="true">
        <div class="absolute -top-40 -left-40 h-96 w-96 rounded-full bg-blob-1 blur-3xl"></div>
        <div class="absolute top-1/3 -right-40 h-96 w-96 rounded-full bg-blob-2 blur-3xl"></div>
        <div class="absolute -bottom-40 left-1/4 h-96 w-96 rounded-full bg-blob-3 blur-3xl"></div>
    </div>

    @* Cabecera: la herramienta a la izquierda, el propietario a la derecha.
       SIN separador vertical entre los dos: con justify-between quedan en
       extremos opuestos de la barra (a 1.152 px de ancho, la marca propia acaba
       en el 443 y el logo empieza en el 1.115), así que una línea de 1 px
       quedaría flotando en mitad del hueco, sin separar nada. La distancia ya
       hace el trabajo.

       Cabe a 320 px: icono 36 + logo 83 + botón 44 + espacios ≈ 199 px con el
       padding, así que no hay que ocultar nada en móvil. *@
    <header class="pt-safe sticky top-0 z-40 border-b border-line bg-canvas/70 backdrop-blur-xl">
        <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-3 px-4 sm:px-6">
            <a href="/" class="group flex min-w-0 items-center gap-3">
                <Marca TamañoIcono="h-9 w-9" Class="inline-flex items-center gap-2.5" />
            </a>

            <div class="flex shrink-0 items-center gap-3 sm:gap-4">
                <LogoSmc />
                <ThemeToggle />
            </div>
        </div>
    </header>

    <main class="relative mx-auto w-full max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
        @Body
    </main>

    <footer class="pb-safe relative border-t border-line pt-8">
        @* Pie sobrio: solo la autoría y el enlace a la documentación. Aquí no aparece
       ningún nombre de tercero: ni SMC ni ChileCompra. "WatchMercadoPublico" es
       el nombre del producto y "Mercado Público" aparece solo en el encabezado
       de la página, como uso nominativo para decir de dónde salen los datos. *@
        <div class="mx-auto flex max-w-6xl flex-col items-center gap-2 px-4 text-center text-xs text-muted">
            <p>© @DateTime.Now.Year WatchMercadoPublico</p>
            <a href="https://api.mercadopublico.cl/" target="_blank" rel="noopener noreferrer"
               class="inline-flex items-center gap-1.5 font-semibold transition hover:text-marca-b">
                <Icon Name="externo" Size="13" />
                Documentación de la API
            </a>
        </div>
    </footer>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        // El tema ya lo aplicó el script en línea de index.html antes de pintar;
        // aquí solo se lee para que el botón muestre el icono correcto.
        await Tema.InicializarAsync();
    }
}