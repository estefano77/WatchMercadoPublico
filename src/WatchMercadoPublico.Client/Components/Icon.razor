    /// <summary>Nombre del icono, con las claves del diccionario Rutas.</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = default!;

    /// <summary>Tamaño en píxeles. 24 por defecto, como en Lucide.</summary>
    [Parameter] public int Size { get; set; } = 24;

    /// <summary>Clases CSS extra del &lt;svg&gt;.</summary>
    [Parameter] public string? Class { get; set; }

    // El contenido viene del diccionario de arriba, nunca de entrada de
    // usuario, así que inyectarlo como MarkupString es seguro. Lo que llega de
    // la API (nombre de la licitación, organismo) NO se hace así: ese texto se
    // escapa con Formato.Escapar antes de tocar el HTML.
    private string Contenido => Rutas.TryGetValue(Name, out var ruta) ? ruta : Rutas["info"];
