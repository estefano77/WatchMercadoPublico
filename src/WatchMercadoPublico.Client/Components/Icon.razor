     width="@Size" height="@Size" viewBox="0 0 24 24" fill="none"
     stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
     class="@Class" aria-hidden="true" focusable="false">
    @((MarkupString)Contenido))
</svg>

