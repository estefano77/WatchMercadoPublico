@*
    Aviso de estado: error, aviso o información.

    Un solo componente para los tres casos: si hay tres componentes para tres
    colores, acaba habiendo cuatro estilos distintos para el mismo error.

    Se pinta si hay Mensaje O si hay contenido hijo. La guarda solo con
    'Mensaje is not null' es un fallo silencioso muy cómodo: un aviso usado
    como contenedor, con <ChildContent> y sin Mensaje, no pinta nada y parece
    que la condición que lo rodea esté mal.
*@

@if (!Cerrado && (Mensaje is not null || ChildContent is not null))
{
    <div role="@Rol" class="@ClaseContenedor">
        <span class="@ClaseIcono">
            <Icon Name="@NombreIcono" Size="18" />
        </span>
        <div class="min-w-0 flex-1">
            @if (Titulo is not null)
            {
                <p class="@ClaseTitulo">@Titulo</p>
            }
            @if (Mensaje is not null)
            {
                <p class="@ClaseMensaje">@Mensaje</p>
            }
            @ChildContent
        </div>
        @if (Cerrable)
        {
            <button type="button" @onclick="Cerrar"
                    class="grid h-9 w-9 shrink-0 place-items-center rounded-lg text-muted transition hover:bg-hover hover:text-ink"
                    aria-label="Cerrar aviso">
                <Icon Name="x" Size="16" />
            </button>
        }
    </div>
}

@* El código de este componente vive en Aviso.razor.cs. *@
