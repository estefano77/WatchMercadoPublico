<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    ===================================================================
    WatchMercadoPublico en IIS

    El sitio se publica como aplicación web ASP.NET Core: hay que instalar el
    Hosting Bundle de .NET (no solo el ASP.NET Core Runtime), o el proceso no
    arranca con "You must install or update .NET".

    No hay límite de subida: la aplicación no recibe ficheros. El de MERCADOPÚBLICO
    es el tope de DÍAS que se barren por consulta (configurable con
    MercadoPublico:DiasMaximos), no un tamaño en bytes.
    ===================================================================
  -->

  <system.webServer>
    <handlers>
      <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
    </handlers>

    <aspNetCore processPath=".\WatchMercadoPublico.Server.exe"
                arguments=""
                stdoutLogEnabled="false"
                stdoutLogFile=".\logs\stdout"
                hostingModel="OutOfProcess">

      <environmentVariables>
        <!--
          El TICKET va aquí, NUNCA en un fichero del sitio.

          Estando "always" en el repositorio, si el ticket se guardara en
          appsettings.json acabaría publicado y sería una credencial filtrada
          a todo el que descargue la web. Un ticket personal da acceso al
          consumo del cupo de MercadoPúblico de quien lo pidió.

          Definirlo como variable de entorno tiene una ventaja extra: en el
          panel de IIS se cambia sin tocar ficheros ni reiniciar el pool.
        -->
        <environmentVariable name="MercadoPublico__Ticket" value="PEGAR-AQUI-EL-TICKET" />
        <environmentVariable name="MercadoPublico__ModoConsulta" value="v1" />
      </environmentVariables>

    </aspNetCore>

    <security>
      <requestFiltering>
        <!-- Esta app no sube ficheros: se limitan los métodos para que la
             superficie expuesta sea la mínima. -->
        <requestLimits maxAllowedContentLength="1048576" />
      </requestFiltering>
      <httpProtocol>
        <!--
          En algunos hostings Windows, HTTP/2 con respuestas que declaran
          Content-Length rompe la descarga de los .wasm y Blazor se queda en
          "Cargando". Por defecto se permite HTTP/1.1 y 2; si aparece el
          problema, deja solo HTTP/1.1 con enabledProtocols.
        -->
        <customHeaders>
          <add name="X-Content-Type-Options" value="nosniff" />
          <add name="X-Frame-Options" value="SAMEORIGIN" />
          <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
          <remove name="X-Powered-By" />
        </customHeaders>
      </httpProtocol>
    </security>

    <httpErrors existingResponse="PassThrough" />
  </system.webServer>

</configuration>